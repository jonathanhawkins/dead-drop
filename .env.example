# =====================================================================
# DEAD DROP — environment template. Copy to .env.local and fill in.
#   cp .env.example .env.local
# =====================================================================

# ---- Server / dev ----
PORT=4317                 # dev server port (default avoids common 3000/3001 clashes)
PUBLIC_BASE_URL=          # your public HTTPS tunnel URL (cloudflared/ngrok)

# ---- Butterbase ----
BUTTERBASE_APP_ID=app_xxxxxxxxxxxx
BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_xxxxxxxxxxxx
BUTTERBASE_API_BASE=https://api.butterbase.ai
BUTTERBASE_SERVICE_KEY=bb_sk_xxx           # SERVER ONLY
NEXT_PUBLIC_BUTTERBASE_APP_ID=app_xxxxxxxxxxxx
NEXT_PUBLIC_BUTTERBASE_API_BASE=https://api.butterbase.ai
NEXT_PUBLIC_BUTTERBASE_API_URL=https://api.butterbase.ai/v1/app_xxxxxxxxxxxx
NEXT_PUBLIC_BUTTERBASE_REALTIME_TOKEN=bb_sk_xxx   # dashboard realtime (trusted projector)

# ---- AI gateway ----
AI_MODEL=anthropic/claude-sonnet-4.6
AI_VISION_MODEL=anthropic/claude-sonnet-4.6
MOCK_AI=true              # true while developing to preserve AI credits

# ---- Photon / Spectrum ----
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
PHOTON_API_BASE=https://spectrum.photon.codes
PHOTON_HANDLER_LINE=+1XXXXXXXXXX
PHOTON_CHANNEL=imessage
PHOTON_WEBHOOK_SIGNING_SECRET=
MOCK_PHOTON=false

# ---- RocketRide (optional) ----
USE_ROCKETRIDE=false
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=

# ---- Voice opener (optional) ----
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ELEVENLABS_API_KEY=
VAPI_API_KEY=

# ---- Dashboard ----
DASHBOARD_OVERRIDE_TOKEN=change-me
